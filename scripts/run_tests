#!/bin/bash

TESTS_INIT=tests/minimal_init.lua
TESTS_DIR=tests/
# Real language servers make spec files slower than plenary's 50s default.
TESTS_TIMEOUT_MS=600000

nvim \
    --headless \
    --noplugin \
    -u ${TESTS_INIT} \
    -c "PlenaryBustedDirectory ${TESTS_DIR} { minimal_init = '${TESTS_INIT}', timeout = ${TESTS_TIMEOUT_MS} }"
